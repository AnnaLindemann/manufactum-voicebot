{
  // Type-check only. Covers test files and discovery scripts, which the build config intentionally
  // excludes. The build config (tsconfig.json) compiles src/ alone, so neither is emitted to dist/.
  // This config is also the project used by type-aware ESLint rules (see D-013).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src", "tests", "scripts"]
}

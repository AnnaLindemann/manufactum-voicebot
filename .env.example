# Optional. TCP port the server binds to. Leave it UNSET on Render: the platform injects its own port
# and a hard-coded value makes the service unreachable. Defaults to 3000 when unset or empty. A value
# that is not an integer from 1 to 65535 — including `0` — fails the server at startup rather than
# binding an OS-assigned ephemeral port nothing can reach.
PORT=3000

MANUFACTUM_API_BASE_URL=
MANUFACTUM_API_KEY=
MANUFACTUM_API_KEY_HEADER=

# Optional. Internal upstream request timeout in milliseconds. Defaults to 8000.
MANUFACTUM_API_TIMEOUT_MS=

# Optional. Express `trust proxy` setting, used to resolve the client IP the rate limiters count
# against. Leave unset when the service is reached directly. Set it only when a known proxy or load
# balancer sits in front, e.g. `1` for a single hop. On Render, requests arrive through the platform's
# proxy, so this must be set there for per-IP limiting to distinguish callers. See `D-018`.
TRUST_PROXY=

# PostgreSQL connection string for the RAG document store. Required by `npm run migrate` (applies
# `migrations/`) and by `POST /api/rag/query`. The server verifies it is present at startup and exits
# non-zero without it, so a release cannot boot, report healthy, and then fail every retrieval call.
# Presence only: no connection is opened at startup. Not needed for `npm run check`.
DATABASE_URL=

# Optional. How the connection to DATABASE_URL is protected. One of `disable`, `require`, or
# `verify-full`. Unset means no `ssl` option is passed to the driver at all, so whatever `sslmode` the
# connection string itself carries keeps governing — that is the local-development default and it is
# why a loopback Postgres needs nothing set here.
#
#   disable      plaintext, chosen explicitly. Only correct for a database on the same host.
#   require      encrypted, but the server certificate is NOT verified. Stops passive eavesdropping,
#                not an active man in the middle. A documented stopgap, never a production setting.
#   verify-full  encrypted and verified against DATABASE_CA_CERT_PATH. This is what a managed database
#                reached over the public internet (Supabase, Neon, RDS) must use.
#
# `prefer` and `allow` are deliberately not accepted: both mean "encrypt if it happens to work", which
# is the silent downgrade this setting exists to prevent. An unknown value fails the server at startup.
DATABASE_SSL_MODE=

# Required when DATABASE_SSL_MODE=verify-full, ignored otherwise. Filesystem path to the PEM CA bundle
# the database's certificate is verified against — NOT the certificate itself and NOT an inline PEM.
# On Render, add the provider's CA as a Secret File; Render mounts it at `/etc/secrets/<filename>`.
# The file is read once at startup: a missing, unreadable, or non-PEM file fails the deploy instead of
# failing every TLS handshake later. Its contents are never logged. No CA certificate is committed to
# this repository; download it from the database provider's console.
DATABASE_CA_CERT_PATH=

# Required to run the destructive RAG PostgreSQL integration tests. Must point at a DISPOSABLE
# database whose name ends with `_test` (e.g. a local `manufactum_rag_test`), separate from the
# working `DATABASE_URL`. The suite fails fast (it does NOT skip) if this is unset, if it resolves to
# the same database as DATABASE_URL, or if the connected database name does not end with `_test`, so
# the destructive TRUNCATE can never reach the working RAG data. Never point this at DATABASE_URL.
# LOCAL ONLY: it must never be set on Render or on any deployment.
RAG_TEST_DATABASE_URL=

# Optional. Forces the local Transformers.js embedding runtime to use only cached files. The embedding
# profile itself is fixed in code: Xenova/multilingual-e5-small at an immutable Hugging Face commit.
# Leave it unset (or `false`) until a warmed cache has been verified on the running instance: `true`
# turns a cache miss into a failed query instead of a slow one, so enabling it before the cache is
# proven present converts a latency problem into an outage. `npm run rag:warm-embedding-cache` cannot
# populate a cache while this is `true`.
RAG_EMBEDDING_LOCAL_FILES_ONLY=

# Optional. Where the pinned embedding artifact (~118 MB) is cached. Unset uses the library default,
# `node_modules/@xenova/transformers/.cache`, which is inside the installed dependency tree — set this
# to a path that survives a dependency prune if the platform performs one, and that the runtime user
# can read. The same value must be used by the build-time warm-up and by the running server, or the
# server will download the artifact again on its first query.
TRANSFORMERS_CACHE=

# Optional. Internal RAG retrieval minimum cosine similarity threshold, used by the opt-in
# smoke/evaluation scripts and by `POST /api/rag/query`. Defaults to 0.8 and remains provisional until
# calibrated on a labelled Manufactum question set; it is bound to the active embedding profile and
# does not transfer to another model. Operator configuration only — an API caller can never set it.
# Unset takes the default; set-but-malformed or out of the 0..1 range fails the server at startup
# rather than silently retrieving at a relevance bar nobody chose.
RAG_RETRIEVAL_MIN_SCORE=

# Optional. Rate-limit policy for `POST /api/rag/query` ONLY. The product-search limiter is a separate
# code constant (20 requests per minute) and is not affected by these. Defaults: 10 requests per
# 60000 ms per client IP — deliberately stricter than product search, because a RAG query spends CPU
# on this instance running a local embedding model rather than one paid upstream call.
#
# Bounded on purpose: 1..60 requests and a 1000..600000 ms window. The limit can be tightened freely
# and loosened only within that range, so it can be tuned for a demo without being switched off. `0`,
# a negative, a fractional, or an out-of-range value fails the server at startup.
#
# The counter is in memory and per process: it does not survive a restart and is not shared between
# instances, so the deployment must run a SINGLE instance.
RAG_RATE_LIMIT_MAX_REQUESTS=
RAG_RATE_LIMIT_WINDOW_MS=

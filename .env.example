PORT=3000

MANUFACTUM_API_BASE_URL=
MANUFACTUM_API_KEY=
MANUFACTUM_API_KEY_HEADER=

# Optional. Internal upstream request timeout in milliseconds. Defaults to 8000.
MANUFACTUM_API_TIMEOUT_MS=

# Optional. Express `trust proxy` setting, used to resolve the client IP the rate limiter counts
# against. Leave unset when the service is reached directly. Set it only when a known proxy or load
# balancer sits in front, e.g. `1` for a single hop. See `D-018`.
TRUST_PROXY=

# PostgreSQL connection string for the RAG document store. Required by `npm run migrate` (applies
# `migrations/`) and by `POST /api/rag/query`. The server verifies it is present at startup and exits
# non-zero without it, so a release cannot boot, report healthy, and then fail every retrieval call.
# Presence only: no connection is opened at startup. Not needed for `npm run check`.
DATABASE_URL=

# Required to run the destructive RAG PostgreSQL integration tests. Must point at a DISPOSABLE
# database whose name ends with `_test` (e.g. a local `manufactum_rag_test`), separate from the
# working `DATABASE_URL`. The suite fails fast (it does NOT skip) if this is unset, if it resolves to
# the same database as DATABASE_URL, or if the connected database name does not end with `_test`, so
# the destructive TRUNCATE can never reach the working RAG data. Never point this at DATABASE_URL.
RAG_TEST_DATABASE_URL=

# Optional. Forces the local Transformers.js embedding runtime to use only cached files. The embedding
# profile itself is fixed in code: Xenova/multilingual-e5-small at an immutable Hugging Face commit.
RAG_EMBEDDING_LOCAL_FILES_ONLY=
TRANSFORMERS_CACHE=

# Optional. Internal RAG retrieval minimum cosine similarity threshold, used by the opt-in
# smoke/evaluation scripts and by `POST /api/rag/query`. Defaults to 0.8 and remains provisional until
# calibrated on a labelled Manufactum question set; it is bound to the active embedding profile and
# does not transfer to another model. Operator configuration only — an API caller can never set it.
# Unset takes the default; set-but-malformed or out of the 0..1 range fails the server at startup
# rather than silently retrieving at a relevance bar nobody chose.
RAG_RETRIEVAL_MIN_SCORE=

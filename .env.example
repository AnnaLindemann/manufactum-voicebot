PORT=3000

MANUFACTUM_API_BASE_URL=
MANUFACTUM_API_KEY=
MANUFACTUM_API_KEY_HEADER=

# Optional. Internal upstream request timeout in milliseconds. Defaults to 8000.
MANUFACTUM_API_TIMEOUT_MS=

# Optional. Express `trust proxy` setting, used to resolve the client IP the rate limiter counts
# against. Leave unset when the service is reached directly. Set it only when a known proxy or load
# balancer sits in front, e.g. `1` for a single hop. See `D-018`.
TRUST_PROXY=

# PostgreSQL connection string for the RAG document store. Required only by `npm run migrate`
# (applies `migrations/`) and by the PostgreSQL store at runtime. Not needed for `npm run check`.
DATABASE_URL=

# Optional. Connection string for a disposable PostgreSQL database used by the RAG integration tests.
# When unset, those tests are skipped and no database connection is made.
RAG_TEST_DATABASE_URL=

# Optional. Forces the local Transformers.js embedding runtime to use only cached files. The embedding
# profile itself is fixed in code: Xenova/multilingual-e5-small at an immutable Hugging Face commit.
RAG_EMBEDDING_LOCAL_FILES_ONLY=
TRANSFORMERS_CACHE=

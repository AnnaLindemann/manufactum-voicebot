  "engines": {
    "node": "^24.11.0"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "rag:embed-staged": "tsx scripts/embed-staged-faq-chunks.ts",
    "rag:smoke-embedding": "tsx scripts/smoke-rag-embedding-runtime.ts",
    "rag:smoke-retrieval": "tsx scripts/smoke-rag-retrieval.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project tsconfig.check.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnnaLindemann/manufactum-voicebot.git"
  },
  "keywords": [],
  "author": "",
